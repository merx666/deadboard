{
  "browser": {
    "mode": "launch",
    "executable_path": "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome",
    "headless": true
  },
  "start_url": { "url": "https://tholtman1-del.github.io/deadboard/app.html" },
  "actions": [
    { "step_id": "settle", "action": "wait_for_timeout", "duration_ms": 6000 }
  ],
  "capture": {
    "at_end": ["url", "dom", "screenshot", "accessibility", "storage"],
    "events": ["network", "console", "page-errors"],
    "network": {
      "request_body": false,
      "response_body": true,
      "header_values": true
    },
    "limits": {
      "max_events": 20000,
      "max_event_allocation_bytes": 150000000,
      "max_total_event_allocation_bytes": 300000000,
      "max_network_transactions": 2048,
      "max_network_body_bytes": 15000000,
      "max_network_body_allocation_bytes": 150000000,
      "max_network_header_allocation_bytes": 4194304,
      "max_network_metadata_allocation_bytes": 4194304
    }
  }
}
