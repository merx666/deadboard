{
  "name": "deadboard",
  "private": true,
  "version": "0.1.0",
  "description": "Board-level repair trainer: diagnose and fix simulated circuit boards on a realistic bench, in the browser.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/merx666/deadboard.git"
  },
  "homepage": "https://github.com/merx666/deadboard#readme",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "test": "node --import tsx --test test/*.test.ts",
    "test:watch": "node --import tsx --test --watch test/*.test.ts",
    "spice": "tsx src/spice/cli.ts",
    "schematic": "tsx src/io/schematic-cli.ts",
    "calibrate": "tsx src/calibrate-cli.ts",
    "demos": "tsx scripts/build-demos.ts",
    "example-mod": "tsx scripts/build-example-mod.ts",
    "videos": "tsx scripts/videos/record.ts",
    "showcase": "tsx scripts/promo/showcase.ts",
    "smoke": "tsx scripts/smoke/bench.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@webgpu/types": "^0.1.51",
    "marked": "18.1.2",
    "playwright-core": "^1.58.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "earcut": "^3.0.1"
  }
}
